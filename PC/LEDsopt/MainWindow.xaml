<Window x:Class="LEDspot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LEDspot"
        mc:Ignorable="d"
        Title="LEDspot" Height="520" Width="800">
    <Grid>
        <!-- 포트 선택과 연결 -->
        <TextBlock Text="포트" HorizontalAlignment="Left" Margin="24,9,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="PortBox" HorizontalAlignment="Left" Margin="60,5,0,0" VerticalAlignment="Top" Width="100" Height="24" DropDownOpened="PortBox_DropDownOpened" SelectionChanged="PortBox_SelectionChanged"/>
        <Button x:Name="ConnectButton" Content="연결" HorizontalAlignment="Left" Margin="170,5,0,0" VerticalAlignment="Top" Width="80" Height="24" Click="ConnectButton_Click"/>

        <Rectangle HorizontalAlignment="Center" Height="443" Margin="0,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="748"/>

        <!-- LED 표시 (초록, 노랑, 빨강) -->
        <Ellipse x:Name="GreenLed" HorizontalAlignment="Left" Height="70" Margin="48,50,0,0" Stroke="Black" VerticalAlignment="Top" Width="71" Fill="LightGray"/>
        <Ellipse x:Name="YellowLed" HorizontalAlignment="Left" Height="71" Margin="165,50,0,0" Stroke="Black" VerticalAlignment="Top" Width="70" Fill="LightGray"/>
        <Ellipse x:Name="RedLed" HorizontalAlignment="Left" Height="71" Margin="275,50,0,0" Stroke="Black" VerticalAlignment="Top" Width="71" Fill="LightGray"/>

        <!-- 입력: 반복 횟수, 반복 간격 (기본값 없음) -->
        <TextBlock HorizontalAlignment="Left" Height="26" Margin="52,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="79" Text="횟수"/>
        <TextBox x:Name="RepeatBox" HorizontalAlignment="Left" Height="54" Margin="165,168,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="181" VerticalContentAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Height="26" Margin="52,268,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" Text="반복간격 (ms)"/>
        <TextBox x:Name="IntervalBox" HorizontalAlignment="Left" Height="54" Margin="165,254,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="181" VerticalContentAlignment="Center"/>

        <!-- 저장하기, 되돌리기 -->
        <Button x:Name="SaveButton" Content="저장하기" HorizontalAlignment="Left" Margin="52,342,0,0" VerticalAlignment="Top" Width="134" Height="52" Click="Save_Click"/>
        <Button x:Name="RestoreButton" Content="되돌리기" HorizontalAlignment="Left" Margin="223,343,0,0" VerticalAlignment="Top" Width="145" Height="51" Click="Revert_Click"/>

        <!-- 시작 (B 방식) -->
        <Button x:Name="StartButton" Content="시작" HorizontalAlignment="Left" Height="45" Margin="421,57,0,0" VerticalAlignment="Top" Width="320" Click="StartButton_Click"/>

        <!-- 메타데이터: 현재 방식, 진행 회차, 마지막 CRC 결과, 포트 상태 -->
        <TextBlock x:Name="MetaText" HorizontalAlignment="Left" Margin="421,108,0,0" VerticalAlignment="Top" Width="340" Height="56" TextWrapping="Wrap"/>

        <!-- 결과표 -->
        <DataGrid x:Name="ResultGrid" Margin="388,170,26,26" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="회차" Binding="{Binding Round}"/>
                <DataGridTextColumn Header="방식" Binding="{Binding Mode}"/>
                <DataGridTextColumn Header="랜덤 숫자" Binding="{Binding Number}"/>
                <DataGridTextColumn Header="색" Binding="{Binding Color}"/>
                <DataGridCheckBoxColumn Header="성공 여부" Binding="{Binding Success}"/>
                <DataGridTextColumn Header="시간" Binding="{Binding Time}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
